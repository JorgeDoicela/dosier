# ==============================================================================
# DOSIER - Plantilla Oficial de Variables de Entorno (.env)
# ==============================================================================
# Ubicación canónica: Raíz del repositorio (/dosier/.env)
# Utilizado por Docker Compose, scripts de despliegue y servicios locales.

# ------------------------------------------------------------------------------
# 1. Base de Datos MySQL 8.0 (sigafi_es)
# ------------------------------------------------------------------------------
# DB_HOST: 'host.docker.internal' para conectar a tu MySQL nativo en Windows (Staging local predeterminado).
#          'dosier-db' si levantas el contenedor MySQL aislado con el perfil -WithDb.
DB_HOST=host.docker.internal
DB_PORT_INTERNAL=3306
DB_ROOT_PASSWORD=12345
DB_USER=dosier_user
DB_PASSWORD=12345
DB_PORT=3307

# ------------------------------------------------------------------------------
# 2. Backend Web API (.NET 8 ASP.NET Core)
# ------------------------------------------------------------------------------
BACKEND_PORT=5001
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_32_caracteres_aleatorios
JWT_SETTINGS_SECRET=tu_clave_secreta_sso_de_al_menos_32_caracteres_aleatorios
# FRONTEND_URL:
# - Staging Local con túnel: https://staging-dosier.doicela.dev
# - Producción AWS: https://dosier.doicela.dev
# - Local sin túnel: http://localhost:8080
FRONTEND_URL=https://staging-dosier.doicela.dev
SECURITY_SUPER_ADMIN_CEDULA=1725555377
SECURITY_MASTER_ADMIN_ID=0302144159

# ------------------------------------------------------------------------------
# 3. Frontend Web (React 18 + Vite + Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=8080
FRONTEND_SSL_PORT=443

# ------------------------------------------------------------------------------
# 4. Cloudflare Named Tunnel (Staging con Dominio Propio doicela.dev)
# ------------------------------------------------------------------------------
# Token provisto por Cloudflare Zero Trust para el túnel de staging-dosier.doicela.dev
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_cloudflare_tunnel_aqui

# ------------------------------------------------------------------------------
# 5. Rutas de Montaje y Almacenamiento (Opcional - Defaults automáticos)
# ------------------------------------------------------------------------------
# En entorno local/desarrollo usan las carpetas internas de dosier_api:
# UPLOADS_PATH=./backend/dosier_api/uploads
# BACKUPS_PATH=./backend/dosier_api/backups
# CERTS_PATH=./certs

# ------------------------------------------------------------------------------
# 6. Politica de Base de Datos en Despliegues CI/CD (AWS Produccion)
# ------------------------------------------------------------------------------
# 'true'  -> Recrea la BD limpia con scripts oficiales (00 a 04) para pruebas en cada despliegue.
# 'false' -> Modo de persistencia definitiva (conserva datos reales de produccion).
RESET_DATABASE_ON_DEPLOY=true
